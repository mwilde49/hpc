[submodule "containers/bulkrnaseq"]
	path = containers/bulkrnaseq
	url = https://github.com/mwilde49/bulkseq
[submodule "containers/psoma"]
	path = containers/psoma
	url = https://github.com/mwilde49/psoma.git
[submodule "containers/10x"]
	path = containers/10x
	url = https://github.com/mwilde49/10x
[submodule "containers/virome"]
	path = containers/virome
	url = https://github.com/mwilde49/virome-pipeline
[submodule "containers/sqanti3"]
	path = containers/sqanti3
	url = https://github.com/mwilde49/longreads.git
[submodule "containers/dconvatac"]
	path = containers/dconvatac
	url = https://github.com/mwilde49/dconvatac
[submodule "containers/dpnvisium"]
	path = containers/dpnvisium
	url = https://github.com/mwilde49/dpnvisium
[submodule "containers/painrrf"]
	path = containers/painrrf
	# SSH host alias (not HTTPS, unlike every other submodule here) --
	# painrrf is the only private repo in this framework, so it needs the
	# dedicated read-only deploy key via an SSH config Host alias
	# ("github-painrrf-deploy") rather than anonymous HTTPS, which works
	# for the public submodules above with zero credential setup.
	url = git@github-painrrf-deploy:mwilde49/painrrf.git
